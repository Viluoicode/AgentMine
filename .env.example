# Examples only: AgentMine does not automatically read .env files.
# Export these values in your shell before running the bootstrap.
AGENTMINE_ENVIRONMENT=development
AGENTMINE_LOG_LEVEL=INFO

# Audit identity for explicit local operator decisions (not remote authentication).
AGENTMINE_OPERATOR_ID=

# Optional: Superteam smoke, workspace discover --live, or --live-superteam-refresh.
# Supply an existing authorized key through your process environment/secret manager.
# Never commit a real key. The ordinary bootstrap does not read this setting.
AGENTMINE_SUPERTEAM_API_KEY=

